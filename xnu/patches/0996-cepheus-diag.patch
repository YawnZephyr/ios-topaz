diff --git a/osfmk/kern/startup.c b/osfmk/kern/startup.c
--- a/osfmk/kern/startup.c
+++ b/osfmk/kern/startup.c
@@ -687,6 +687,7 @@
 #ifdef  IOKIT
 	kernel_bootstrap_log("PE_init_iokit");
 	PE_init_iokit();
+	printf("CEPH: PE_init_iokit done\n");
 #endif
 
 	assert(ml_get_interrupts_enabled() == FALSE);
@@ -702,21 +703,25 @@
 	ml_spin_debug_clear_self();
 #endif
 	(void) spllo();         /* Allow interruptions */
+	printf("CEPH: interrupts enabled (spllo done)\n");
 
