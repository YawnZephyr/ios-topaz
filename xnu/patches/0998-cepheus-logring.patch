diff --git a/osfmk/kern/printf.c b/osfmk/kern/printf.c
--- a/osfmk/kern/printf.c
+++ b/osfmk/kern/printf.c
@@ -856,9 +856,50 @@
 #endif
 }
 
+/*
+ * cepheus: keep the console log in .bss so that a later boot's shim can read it
+ * straight out of DRAM. Writing through the kernel's own virtual address needs
+ * no mapping, and each completed line is cleaned from the cache so it survives
+ * a reset even when the panic path itself dies.
+ */
+#define CEPH_LOGBUF_SIZE  (1u << 20)
+#define CEPH_LOGBUF_MAGIC 0x43455048u   /* 'CEPH' */
+
+extern void CleanPoC_DcacheRegion_Force(vm_offset_t va, size_t length);
+
+__attribute__((section("__DATA,__cephlog"), aligned(16384)))
+volatile char ceph_logbuf[CEPH_LOGBUF_SIZE];
+
+static void
+ceph_logbuf_putc(char c)
+{
+	volatile uint32_t *hdr = (volatile uint32_t *)ceph_logbuf;
+	uint32_t off;
+
+	if (hdr[0] != CEPH_LOGBUF_MAGIC) {
+		hdr[0] = CEPH_LOGBUF_MAGIC;
+		hdr[1] = 0;
+	}
+	off = hdr[1];
+	if (off >= CEPH_LOGBUF_SIZE - 9) {
+		return;
+	}
+	ceph_logbuf[8 + off] = c;
+	ceph_logbuf[8 + off + 1] = 0;
+	hdr[1] = off + 1;
+
+	if (c == '\n') {
+		vm_offset_t start = (off > 128) ? (off - 128) : 0;
+
+		CleanPoC_DcacheRegion_Force(
+		    (vm_offset_t)(ceph_logbuf + 8 + start), off - start + 1);
+	}
+}
+
 void
 cons_putc_locked(char c)
 {
+	ceph_logbuf_putc(c);
 	if (!disableConsoleOutput) {
 		console_write_char(c);
 	}
